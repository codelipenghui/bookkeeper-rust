# Rust build artifacts
/target/
tests/java-compat/target/
**/*.rs.bk

# Cargo.lock is intentionally committed — this repo ships binaries.

# Platform-specific
.DS_Store
._*
Thumbs.db

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/
.nvim/
.zed/

# Local tool state (Claude Code, Codex, other agents)
.claude/
.codex/
.conductor/
.qoder/
.history/

# Logs written by docker-compose / bookies
*.log
logs/

# Local env and secrets
.env
.env.local
*.local.toml

# Optional corporate / proxy CA bundles for Docker builds behind a
# TLS-inspection proxy (Zscaler, mitmproxy, etc.). Drop *.crt files in
# `docker/extra-ca-certs/` and the Dockerfile's chef stage will merge
# them into the build image's trust store. The directory itself is
# tracked via .gitkeep so the Dockerfile COPY always succeeds.
docker/extra-ca-certs/*.crt

# OS / network scratch
*.pid
*.seed
*.pid.lock
